{
  "name": "syran-persona",
  "displayName": "Syran: The Logic Officer",
  "version": "1.1.0",
  "description": "Adopts the Syran Logic Officer persona globally, providing dispassionate logical analysis, formal precision, and probability-driven counsel.",
  "author": "Sal Belal",
  "repository": "https://github.com/sbelal/agent-marketplace",
  "mcpServers": {
    "syran-logic": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/mcp-server/index.js"
      ]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/session-start.js\"",
        "timeout": 15
      }
    ]
  }
}
